            "code": "fn transfer(deps:DepsMut,sender:Addr,recipient:String,id:u64)->Result<Response,ContractError>{let old=authorized(deps.as_ref(),&sender,id)?;let new=deps.api.addr_validate(&recipient)?;OWNER.save(deps.storage,id,&new)?;APPROVAL.remove(deps.storage,id);OWNER_COUNT.update(deps.storage,old.as_str(),|x|->StdResult<_>{Ok(x.unwrap_or_default().saturating_sub(1))})?;OWNER_COUNT.update(deps.storage,new.as_str(),|x|->StdResult<_>{Ok(x.unwrap_or_default()+1)})?;Ok(Response::new())}"
