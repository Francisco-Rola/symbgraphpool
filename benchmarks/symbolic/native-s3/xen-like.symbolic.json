            "code": "fn claim_reward(deps:DepsMut,env:Env,user:Addr,share:Option<(String,u8)>)->Result<Response,ContractError>{let m=USER_MINTS.may_load(deps.storage,user.as_str())?.ok_or(ContractError::Missing)?;if env.block.time.seconds()<m.maturity{return Err(ContractError::MintNotMature)};let g=GLOBAL.load(deps.storage)?;let reward=Uint128::new((g.global_rank.saturating_sub(m.rank).saturating_add(1)) as u128*1_000);USER_MINTS.remove(deps.storage,user.as_str());if let Some((other,pct))=share{let other=deps.api.addr_validate(&other)?;let other_amount=reward.multiply_ratio(pct as u128,100u128);credit(deps.storage,other.as_str(),other_amount)?;credit(deps.storage,user.as_str(),reward.checked_sub(other_amount).map_err(StdError::overflow)?)?;}else{credit(deps.storage,user.as_str(),reward)?;}GLOBAL.update(deps.storage,|mut x|->StdResult<_>{x.total_supply=x.total_supply.checked_add(reward).map_err(StdError::overflow)?;Ok(x)})?;Ok(Response::new())}"
